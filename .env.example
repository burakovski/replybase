# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://cjckdwxkvitdraaxyfhp.supabase.co
# Publishable key (sb_publishable_...) — same as legacy anon
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) — same as legacy service_role; server only
SUPABASE_SERVICE_ROLE_KEY=

# LLM — prefer OpenRouter (OpenAI-compatible). Falls back to OpenAI if only OPENAI_API_KEY is set.
# https://openrouter.ai/
OPENROUTER_API_KEY=
OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional direct OpenAI (used only when OPENROUTER_API_KEY is empty)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Public site origin (sitemap, OG, metadataBase, OpenRouter Referer)
NEXT_PUBLIC_SITE_URL=https://replybase-sigma.vercel.app
